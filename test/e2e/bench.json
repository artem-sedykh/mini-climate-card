{
  "card": "mini-climate-card",
  "resource": "/local/bench/mini-climate-card-bundle.js",
  "entities": [
    {
      "domain": "climate",
      "id": "bench_ac",
      "discovery": {
        "name": "Bench air conditioner",
        "unique_id": "bench_ac",
        "object_id": "bench_ac",
        "modes": ["off", "cool", "heat", "dry", "fan_only"],
        "fan_modes": ["auto", "low", "medium", "high"],
        "preset_modes": ["eco", "boost", "sleep"],
        "mode_command_topic": "bench/ac/mode/set",
        "temperature_command_topic": "bench/ac/temperature/set",
        "fan_mode_command_topic": "bench/ac/fan_mode/set",
        "preset_mode_command_topic": "bench/ac/preset_mode/set",
        "current_temperature_topic": "bench/ac/current_temperature",
        "action_topic": "bench/ac/action",
        "availability_topic": "bench/ac/availability",
        "min_temp": 16,
        "max_temp": 30,
        "temp_step": 0.5
      },
      "state": {
        "bench/ac/availability": "online",
        "bench/ac/current_temperature": "24.0",
        "bench/ac/action": "cooling"
      }
    },
    {
      "domain": "climate",
      "id": "bench_trv",
      "discovery": {
        "name": "Bench radiator valve",
        "unique_id": "bench_trv",
        "object_id": "bench_trv",
        "modes": ["off", "heat"],
        "temperature_command_topic": "bench/trv/temperature/set",
        "mode_command_topic": "bench/trv/mode/set",
        "current_temperature_topic": "bench/trv/current_temperature",
        "availability_topic": "bench/trv/availability",
        "min_temp": 5,
        "max_temp": 30,
        "temp_step": 0.5
      },
      "state": {
        "bench/trv/availability": "online",
        "bench/trv/current_temperature": "21.5"
      }
    },
    {
      "domain": "climate",
      "id": "bench_ac_remote",
      "discovery": {
        "name": "Bench remote air conditioner",
        "unique_id": "bench_ac_remote",
        "object_id": "bench_ac_remote",
        "modes": ["off", "cool", "heat", "dry", "fan_only", "heat_cool"],
        "fan_modes": ["auto", "low", "medium", "high"],
        "preset_modes": ["boost", "eco"],
        "swing_modes": ["off", "vertical"],
        "mode_command_topic": "bench/remote/mode/set",
        "temperature_command_topic": "bench/remote/temperature/set",
        "fan_mode_command_topic": "bench/remote/fan_mode/set",
        "preset_mode_command_topic": "bench/remote/preset_mode/set",
        "swing_mode_command_topic": "bench/remote/swing_mode/set",
        "current_temperature_topic": "bench/remote/current_temperature",
        "action_topic": "bench/remote/action",
        "availability_topic": "bench/remote/availability",
        "min_temp": 16,
        "max_temp": 30,
        "temp_step": 0.5
      },
      "state": {
        "bench/remote/availability": "online",
        "bench/remote/current_temperature": "23.5",
        "bench/remote/action": "cooling"
      }
    },
    {
      "domain": "switch",
      "id": "bench_plug",
      "discovery": {
        "name": "Bench plug",
        "unique_id": "bench_plug",
        "object_id": "bench_plug",
        "command_topic": "bench/plug/set",
        "state_topic": "bench/plug/state",
        "optimistic": true
      },
      "state": {
        "bench/plug/state": "ON"
      }
    },
    {
      "domain": "switch",
      "id": "bench_sleep",
      "discovery": {
        "name": "Bench sleep mode",
        "unique_id": "bench_sleep",
        "object_id": "bench_sleep",
        "command_topic": "bench/sleep/set",
        "state_topic": "bench/sleep/state"
      },
      "state": {
        "bench/sleep/state": "OFF"
      }
    },
    {
      "domain": "sensor",
      "id": "bench_humidity",
      "discovery": {
        "name": "Bench humidity",
        "unique_id": "bench_humidity",
        "object_id": "bench_humidity",
        "state_topic": "bench/humidity",
        "unit_of_measurement": "%",
        "device_class": "humidity"
      },
      "state": {
        "bench/humidity": "48.4"
      }
    },
    {
      "domain": "sensor",
      "id": "bench_power",
      "discovery": {
        "name": "Bench power",
        "unique_id": "bench_power",
        "object_id": "bench_power",
        "state_topic": "bench/power",
        "unit_of_measurement": "W",
        "device_class": "power"
      },
      "state": {
        "bench/power": "742.6"
      }
    },
    {
      "domain": "sensor",
      "id": "bench_clock",
      "discovery": {
        "name": "Bench clock",
        "unique_id": "bench_clock",
        "object_id": "bench_clock",
        "state_topic": "bench/clock"
      },
      "state": {
        "bench/clock": "21:47:08"
      }
    }
  ],
  "views": [
    {
      "title": "Cards",
      "cards": [
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac}}"
        },
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac}}",
          "name": "No secondary info",
          "secondary_info": {
            "hide": "() => true"
          }
        },
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_trv}}",
          "name": "Valve, no fan modes",
          "indicators": {
            "temperature": {
              "icon": "mdi:thermometer",
              "source": {
                "entity": "{{bench_trv}}",
                "attribute": "current_temperature"
              }
            }
          }
        },
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac}}",
          "name": "Fan mode dropdown",
          "secondary_info": {
            "type": "fan-mode-dropdown"
          }
        },
        {
          "type": "custom:mini-climate",
          "entity": "climate.not_here",
          "name": "Missing entity"
        },
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac}}",
          "name": "Hidden parts",
          "hide_icon": true,
          "hide_current_temperature": true,
          "toggle": {
            "hide": true
          },
          "secondary_info": {
            "hide": "() => true"
          }
        },
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac}}",
          "name": "Icon hidden while offline",
          "hide_icon": "(climate_entity) => climate_entity.state === 'unavailable'"
        },
        {
          "type": "custom:mini-climate",
          "entity": "climate.not_here",
          "name": "Missing and icon templated",
          "hide_icon": "(climate_entity) => climate_entity.state === 'unavailable'"
        },
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac}}",
          "name": "Preset buttons",
          "buttons": {
            "eco": {
              "icon": "mdi:leaf",
              "state": {
                "attribute": "preset_mode",
                "mapper": "state => state === 'eco' ? 'on' : 'off'"
              },
              "active": "state => state === 'on'",
              "toggle_action": "(state, entity) => this.call_service('climate', 'set_preset_mode', { entity_id: entity.entity_id, preset_mode: state === 'on' ? 'none' : 'eco' })"
            },
            "boost": {
              "icon": "mdi:weather-hurricane",
              "state": {
                "attribute": "preset_mode",
                "mapper": "state => state === 'boost' ? 'on' : 'off'"
              },
              "active": "state => state === 'on'",
              "toggle_action": "(state, entity) => this.call_service('climate', 'set_preset_mode', { entity_id: entity.entity_id, preset_mode: state === 'on' ? 'none' : 'boost' })"
            }
          }
        },
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac}}",
          "name": " ",
          "hide_icon": true,
          "toggle": {
            "hide": true
          },
          "fan_mode": {
            "hide": true
          },
          "secondary_info": {
            "hide": "() => true"
          }
        }
      ]
    },
    {
      "title": "As people write them",
      "cards": [
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac_remote}}",
          "name": "Remote, as people write it",
          "hvac_mode": {
            "source": {
              "off": "Stopped",
              "cool": "Cooling",
              "heat": "Heating",
              "dry": "Drying",
              "fan_only": "Fan",
              "heat_cool": "Automatic"
            }
          },
          "fan_mode": {
            "source": {
              "auto": "Automatic",
              "low": "Gentle",
              "medium": "Middling",
              "high": "Strong"
            }
          },
          "indicators": {
            "humidity": {
              "tap_action": "more-info",
              "icon": "mdi:water",
              "unit": "%",
              "round": 1,
              "source": {
                "entity": "{{bench_humidity}}"
              }
            },
            "power_consumption": {
              "tap_action": {
                "action": "more-info"
              },
              "icon": "mdi:flash",
              "unit": "W",
              "round": 1,
              "source": {
                "entity": "{{bench_power}}"
              }
            },
            "power": {
              "icon": "mdi:power-plug",
              "source": {
                "entity": "{{bench_plug}}",
                "values": {
                  "on": "powered",
                  "off": "idle"
                },
                "mapper": "value => this.source.values[value]"
              }
            }
          },
          "buttons": {
            "swing_mode": {
              "type": "dropdown",
              "icon": "mdi:approximately-equal",
              "state": {
                "attribute": "swing_mode"
              },
              "active": "state => state !== 'off'",
              "source": {
                "off": "Still",
                "vertical": "Sweeping"
              },
              "change_action": "(selected, state, entity) => this.call_service('climate', 'set_swing_mode', { entity_id: entity.entity_id, swing_mode: selected })"
            },
            "preset_mode": {
              "type": "dropdown",
              "icon": {
                "template": "state => state === 'boost' ? 'mdi:fan-chevron-up' : state === 'eco' ? 'mdi:fan-chevron-down' : 'mdi:fan-speed-3'"
              },
              "state": {
                "attribute": "preset_mode"
              },
              "active": "state => state !== 'none'",
              "source": {
                "none": "Plain",
                "boost": "Turbo",
                "eco": "Quiet"
              },
              "change_action": "(selected, state, entity) => this.call_service('climate', 'set_preset_mode', { entity_id: entity.entity_id, preset_mode: selected })"
            },
            "sleep": {
              "icon": "mdi:weather-night",
              "state": {
                "entity": "{{bench_sleep}}"
              }
            },
            "power_switch": {
              "icon": "mdi:power-plug",
              "state": {
                "entity": "{{bench_plug}}"
              }
            }
          }
        }
      ]
    },
    {
      "title": "Answers people were given",
      "cards": [
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac}}",
          "name": " ",
          "hide_icon": true,
          "toggle": {
            "hide": true
          },
          "fan_mode": {
            "hide": true
          },
          "secondary_info": {
            "hide": "() => true"
          }
        },
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac}}",
          "name": "Icon only",
          "indicators": {
            "window": {
              "icon": {
                "template": "(value) => (value === 'on' ? 'mdi:window-open' : 'mdi:window-closed')",
                "style": "(value) => (value === 'on' ? { color: 'orange' } : {})"
              },
              "value": {
                "style": "() => ({ display: 'none' })"
              },
              "source": {
                "entity": "{{bench_plug}}"
              }
            }
          }
        },
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac}}",
          "name": "Shortened value",
          "indicators": {
            "clock": {
              "icon": "mdi:clock-outline",
              "source": {
                "entity": "{{bench_clock}}",
                "mapper": "value => (typeof value === 'string' ? value.slice(0, 5) : value)"
              }
            }
          }
        },
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac}}",
          "name": "Mode icon by action",
          "hvac_mode": {
            "style": "(value, entity) => ({ color: entity.attributes.hvac_action === 'cooling' ? 'rgb(0, 0, 255)' : 'rgb(255, 0, 0)' })"
          }
        },
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac}}",
          "name": "Indicator by mode",
          "indicators": {
            "floor": {
              "icon": {
                "template": "() => 'mdi:heating-coil'",
                "style": "(value, entity, climate_entity) => ({ color: climate_entity.state === 'cool' ? 'rgb(0, 0, 255)' : 'rgb(255, 0, 0)' })"
              },
              "source": {
                "entity": "{{bench_humidity}}"
              },
              "unit": "%"
            }
          }
        }
      ]
    },
    {
      "title": "Repro #270",
      "cards": [
        {
          "type": "custom:mini-climate",
          "entity": "{{bench_ac_remote}}",
          "name": "Fan mode dropdown",
          "hide_current_temperature": true,
          "secondary_info": {
            "type": "fan-mode-dropdown"
          },
          "hvac_mode": {
            "source": {
              "off": "Off",
              "cool": "Cool",
              "heat": "Heat",
              "dry": "Dry",
              "fan_only": "Fan",
              "heat_cool": "Auto"
            }
          },
          "fan_mode": {
            "hide": true,
            "source": {
              "auto": "Auto",
              "low": "Low",
              "medium": "Medium",
              "high": "High"
            }
          },
          "indicators": {
            "temperature": {
              "icon": "mdi:thermometer",
              "unit": "°C",
              "round": 1,
              "source": {
                "entity": "{{bench_trv}}",
                "attribute": "current_temperature"
              }
            },
            "humidity": {
              "icon": "mdi:water",
              "unit": "%",
              "round": 1,
              "source": {
                "entity": "{{bench_humidity}}"
              }
            }
          },
          "buttons": {
            "boost": {
              "icon": "mdi:weather-hurricane",
              "state": {
                "attribute": "preset_mode",
                "mapper": "state => state === 'boost' ? 'on' : 'off'"
              },
              "active": "state => state === 'on'",
              "toggle_action": "(state, entity) => this.call_service('climate', 'set_preset_mode', { entity_id: entity.entity_id, preset_mode: state === 'on' ? 'none' : 'boost' })"
            },
            "eco": {
              "icon": "mdi:leaf",
              "state": {
                "attribute": "preset_mode",
                "mapper": "state => state === 'eco' ? 'on' : 'off'"
              },
              "active": "state => state === 'on'",
              "toggle_action": "(state, entity) => this.call_service('climate', 'set_preset_mode', { entity_id: entity.entity_id, preset_mode: state === 'on' ? 'none' : 'eco' })"
            }
          },
          "toggle": {
            "hide": true,
            "default": true
          }
        }
      ]
    }
  ]
}

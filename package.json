{
  "name": "mini-climate-card",
  "version": "v2.7.4",
  "description": "a/c card for Home Assistant Lovelace UI",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "climate",
    "custom-cards"
  ],
  "main": "src/main.js",
  "module": "src/main.js",
  "repository": "git@github.com:artem-sedykh/mini-climate-card.git",
  "author": "Artem Sedykh <anavrin72@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@open-wc/testing": "^5.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/dev-server-rollup": "^1.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rollup": "^4.63.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "npm run lint && npm run typecheck && npm run format:check && npm run test && npm run rollup && npm run check:bundle",
    "rollup": "rollup -c",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch": "rollup -c --watch --environment BUILD:development",
    "check:bundle": "node scripts/check-bundle.mjs",
    "dev": "rollup -c --environment BUILD:development",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "web-test-runner",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  }
}

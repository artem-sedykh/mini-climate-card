{
  "name": "mini-climate-card",
  "version": "v2.7.4",
  "description": "a/c card for Home Assistant Lovelace UI",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "climate",
    "custom-cards"
  ],
  "main": "src/main.js",
  "module": "src/main.js",
  "repository": "git@github.com:artem-sedykh/mini-climate-card.git",
  "author": "Artem Sedykh <anavrin72@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@lit-labs/scoped-registry-mixin": "^1.0.3",
    "@material/mwc-list": "^0.27.0",
    "@material/mwc-menu": "^0.27.0",
    "@material/mwc-ripple": "^0.27.0",
    "lit": "^3.1.0",
    "resize-observer-polyfill": "^1.5.1"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/plugin-proposal-class-properties": "^7.3.3",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-transform-template-literals": "^7.2.0",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "babel-plugin-iife-wrap": "^1.1.0",
    "babel-preset-minify": "^0.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "rollup": "^4.62.5",
    "rollup-plugin-node-resolve": "^5.2.0"
  },
  "scripts": {
    "build": "npm run lint && npm run format:check && npm run rollup && npm run babel && npm run check:bundle",
    "rollup": "rollup -c",
    "babel": "babel dist/mini-climate-card-bundle.js --out-file dist/mini-climate-card-bundle.js",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch": "rollup -c --watch",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
